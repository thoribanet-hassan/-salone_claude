// مخطط قاعدة بيانات «صالون» — مبني على Baseline Specification V2
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // اتصال مجمّع (pooled) للتشغيل على Vercel
  directUrl = env("DIRECT_URL") // اتصال مباشر للترحيلات (migrations)
}

// نوع المنشأة — يحدّد الثيم والمصطلحات فقط؛ كل السلوك يُضبط من لوحة التحكم
enum FacilityType {
  male_barber
  female_salon
  restaurant
  clinic
  general // أي منشأة أخرى
}

// خطة الاشتراك — تُضبط يدوياً في الـ MVP
enum Plan {
  basic
  pro
  premium
  enterprise
}

// أدوار المستخدمين
enum Role {
  manager
  barber
}

// حالة الحلاق
enum UserStatus {
  available
  unavailable
  busy
}

// حالة التذكرة
enum TicketStatus {
  waiting
  serving
  skipped
  completed
  cancelled
}

// وضع العدّاد
enum CountdownMode {
  auto // يبدأ تلقائياً من وقت الحجز بمدد الخدمات (حلاق/صالون)
  manual // يُطلقه المدير يدوياً عند اقتراب انصراف زبون (مطعم/زحمة)
  none // بلا تقدير زمني إطلاقاً — يتقدّم الدور بإنهاء الموظف فقط (عيادة)
}

// أنواع أحداث قياس المنتج — تُسجَّل من اليوم الأول وتُقرأ في لوحة المؤسس
enum EventType {
  QR_SCANNED
  WAIT_PAGE_OPENED
  WAIT_PAGE_REVISITED
  TICKET_CREATED
  TICKET_CANCELLED
  TICKET_CALLED
  SERVICE_STARTED
  SERVICE_COMPLETED
  NO_SHOW
  APPOINTMENT_CREATED
}

// سجل أحداث القياس — append-only بلا علاقات FK عمداً:
// تبقى بيانات القياس حتى لو حُذفت المنشأة أو التذكرة
model Event {
  id        BigInt    @id @default(autoincrement())
  type      EventType
  shopId    BigInt?   @map("shop_id")
  ticketId  BigInt?   @map("ticket_id")
  visitorId String?   @map("visitor_id") // كوكي الزائر المجهول — لقياس العودة والتسرّب
  source    String? // مصدر الدخول من رابط/QR: in_store, whatsapp, instagram…
  meta      Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([shopId, createdAt])
  @@index([ticketId])
  @@map("events")
}

// مواضع الإعلانات — يديرها المؤسس فقط من /founder
enum AnnouncementPlacement {
  all // كل الصفحات (يُعرض حيث لا يوجد إعلان مخصص للصفحة)
  home
  join
  ticket
  dashboard
  serve
}

model Announcement {
  id        BigInt                @id @default(autoincrement())
  placement AnnouncementPlacement
  text      String
  linkUrl   String?               @map("link_url")
  isActive  Boolean               @default(true) @map("is_active")
  // استهداف المنشآت: مصفوفة فارغة = يُبث لكل المنشآت
  shopIds   BigInt[]              @default([]) @map("shop_ids")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@index([isActive, placement])
  @@map("announcements")
}

model Shop {
  id           BigInt       @id @default(autoincrement())
  name         String
  ownerName    String       @map("owner_name")
  facilityType FacilityType @map("facility_type") // داخلي: للمظهر والمصطلحات فقط (يُستنتج من النص)
  facilityLabel String      @default("") @map("facility_label") // نوع المنشأة كما كتبه صاحبها — هو الظاهر للزبائن
  shopCode     String       @unique @map("shop_code")
  slug         String       @unique
  plan         Plan         @default(basic)
  timezone     String       @default("Asia/Riyadh")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users    User[]
  tickets  Ticket[]
  settings ShopSettings?
  counters TicketCounter[]
  services Service[]

  @@map("shops")
}

model ShopSettings {
  shopId           BigInt  @id @map("shop_id")
  showExpectedTime Boolean @default(true) @map("show_expected_time")
  showPeopleAhead  Boolean @default(true) @map("show_people_ahead")
  showBarberName   Boolean @default(true) @map("show_barber_name")
  showCountdown    Boolean @default(true) @map("show_countdown")
  isOpen           Boolean @default(false) @map("is_open")
  // يتحكم المدير: إظهار الموظفين للاختيار منهم (true) أم حجز موحّد بلا اختيار (false)
  // للنوع general يُفرض دائماً false بصرف النظر عن هذه القيمة
  allowProviderChoice Boolean @default(true) @map("allow_provider_choice")
  // السماح للزبون باختيار الخدمة (وإلا تُستخدم الخدمة الافتراضية بلا سؤال)
  allowServiceChoice Boolean @default(true) @map("allow_service_choice")
  // عرض أسعار الخدمات للزبون
  showPrices Boolean @default(true) @map("show_prices")
  // وضع العدّاد: تلقائي (افتراضي) أو يدوي يُطلقه المدير
  countdownMode CountdownMode @default(auto) @map("countdown_mode")
  // السماح للزبون بالحجز في ساعة معينة (مواعيد)
  allowScheduling Boolean @default(true) @map("allow_scheduling")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

model User {
  id             BigInt     @id @default(autoincrement())
  shopId         BigInt     @map("shop_id")
  name           String
  email          String?    @unique
  passwordHash   String?    @map("password_hash")
  loginCode      String?    @map("login_code")
  role           Role
  status         UserStatus @default(available)
  avgServiceTime Int        @default(20) @map("avg_service_time")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  barberServices BarberService[]

  // رمز الدخول فريد داخل المحل الواحد
  @@unique([shopId, loginCode], name: "uq_shop_login_code")
  @@index([shopId, role, status])
  @@map("users")
}

model Ticket {
  id           BigInt       @id @default(autoincrement())
  publicToken  String       @unique @default(uuid()) @map("public_token")
  shopId       BigInt       @map("shop_id")
  barberId     BigInt?      @map("barber_id")
  serviceId    BigInt?      @map("service_id") // الخدمة الأولى المختارة (للمرجع)
  serviceLabel String?      @map("service_label") // أسماء الخدمات المختارة مجموعةً (للعرض)
  customerName String       @map("customer_name")
  customerPhone String?     @map("customer_phone")
  serviceDate  DateTime     @map("service_date") @db.Date
  ticketNumber Int          @map("ticket_number")
  estDuration  Int          @default(20) @map("est_duration")
  totalPrice   Int          @default(0) @map("total_price") // مجموع أسعار الخدمات وقت الحجز
  status       TicketStatus @default(waiting)
  position     Int?
  scheduledAt  DateTime?    @map("scheduled_at") // موعد محدّد اختاره الزبون (null = دخول الآن)
  readyAt      DateTime?    @map("ready_at") // وقت الجاهزية الذي يحدّده المدير (الوضع اليدوي)
  source       String? // مصدر دخول الزبون وقت الحجز (من ?source= على رابط/QR)
  createdAt    DateTime     @default(now()) @map("created_at")
  startedAt    DateTime?    @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  cancelledAt  DateTime?    @map("cancelled_at")

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber  User?    @relation(fields: [barberId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // منع تكرار رقم التذكرة لنفس المحل في نفس اليوم (الدفاع ضد سباق التزامن)
  @@unique([shopId, serviceDate, ticketNumber], name: "uq_ticket_per_shop_day")
  @@index([shopId, status, createdAt])
  @@index([barberId, status, createdAt])
  @@map("tickets")
}

// عدّاد توليد أرقام التذاكر بأمان (يُقفل صفّه أثناء المعاملة)
model TicketCounter {
  shopId      BigInt   @map("shop_id")
  serviceDate DateTime @map("service_date") @db.Date
  lastNumber  Int      @default(0) @map("last_number")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, serviceDate])
  @@map("ticket_counters")
}

// الخدمات التي يقدّمها المحل — تُدار من لوحة المدير
model Service {
  id              BigInt   @id @default(autoincrement())
  shopId          BigInt   @map("shop_id")
  name            String
  defaultDuration Int      @default(20) @map("default_duration")
  price           Int      @default(0) // سعر الخدمة (ريال) — 0 = غير محدّد
  isActive        Boolean  @default(true) @map("is_active")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barberServices BarberService[]
  tickets        Ticket[]

  @@index([shopId, isActive])
  @@map("services")
}

// مصفوفة زمن كل حلاق لكل خدمة — المصدر الموثوق لحساب الوقت
model BarberService {
  barberId  BigInt @map("barber_id")
  serviceId BigInt @map("service_id")
  duration  Int // مدة هذا الحلاق لهذه الخدمة بالدقائق

  barber  User    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}
